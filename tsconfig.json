{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e-demo/types/**/*.ts",
    ".next-e2e-demo/dev/types/**/*.ts",
    ".next-e2e-live/types/**/*.ts",
    ".next-e2e-live/dev/types/**/*.ts",
    ".next-capturas/types/**/*.ts",
    ".next-capturas/dev/types/**/*.ts",
    ".next-e2e-real/types/**/*.ts",
    ".next-e2e-real/dev/types/**/*.ts",
    ".next-e2e-admin/types/**/*.ts",
    ".next-e2e-admin/dev/types/**/*.ts",
    ".next-build-check/types/**/*.ts",
    ".next-build-check/dev/types/**/*.ts",
    ".next-e2e-consultas/types/**/*.ts",
    ".next-e2e-consultas/dev/types/**/*.ts",
    ".next-preview-consultas/types/**/*.ts",
    ".next-preview-consultas/dev/types/**/*.ts",
    ".next-preview-combo/types/**/*.ts",
    ".next-preview-combo/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
