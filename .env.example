# Copiar a .env.local para desarrollo. Todos los valores son opcionales; vacío = comportamiento de demostración.

# Número de WhatsApp de la tienda: formato internacional, SOLO dígitos (ej.: 54911XXXXXXXX).
# Vacío = modo demo: se prepara la consulta y se muestra vista previa + copiar mensaje, sin abrir ningún chat.
# (También puede fijarse en src/content/store.ts; esta variable tiene prioridad.)
WHATSAPP_NUMBER=

# --- Base de datos PostgreSQL (Supabase) ---
# Funciones serverless: cadena del POOLER en modo TRANSACCIÓN (puerto 6543). Se copia desde Supabase > Connect. SOLO servidor.
DATABASE_URL=
# Para migraciones, respaldos y scripts: pooler en modo SESIÓN (puerto 5432, funciona por IPv4) o conexión directa. Nunca en el sitio web.
DIRECT_URL=
# Opcional: conexiones por instancia (por defecto 1, lo recomendado en serverless) y SSL (disable solo para un PostgreSQL local).
DATABASE_POOL_MAX=
DATABASE_SSL=
# Opcional: tiempos máximos de la conexión de la aplicación (por defecto 8 s para conectar y 10 s por consulta, espera + ejecución; 0 desactiva el plazo de consulta). No cambian el modo de conexión.
DATABASE_CONNECT_TIMEOUT_S=
DATABASE_QUERY_TIMEOUT_MS=

# --- Fotos del panel (Supabase Storage) ---
# Claves SOLO de servidor (jamás con prefijo NEXT_PUBLIC_). La secret key permite escribir: no la compartas.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=product-images
# Solo para npm run storage:probar (comprueba que la clave pública NO puede escribir):
SUPABASE_PUBLISHABLE_KEY=
# Pruebas locales: local = guarda las fotos en una carpeta (nunca en producción real).
STORAGE_DRIVER=

# --- Correo transaccional (confirmar cuentas y recuperar acceso) ---
# Vacío = el registro público queda deshabilitado en producción (el administrador igual puede ingresar). Ver docs/CORREO.md.
MAIL_PROVIDER=      # resend | brevo
MAIL_API_KEY=
MAIL_FROM=          # remitente VERIFICADO en el proveedor, p. ej. Vasconcelo <tienda@tu-dominio.com>

# Límites de uso (opcionales; valores por defecto entre paréntesis)
RATE_LIMIT_INQUIRIES_PER_HOUR=   # consultas preparadas por IP y hora (60)
RATE_LIMIT_VALIDATE_PER_MIN=     # validaciones de carrito por IP y minuto (120)

# --- Cuentas (hito 4) ---
# Secreto para firmar sesiones. En desarrollo se genera solo en .local/auth-secret; en PRODUCCIÓN es obligatorio.
BETTER_AUTH_SECRET=
# URL pública del sitio (por defecto http://localhost:3000). En producción: https://tu-dominio
BETTER_AUTH_URL=   # en Netlify: https://TU-SITIO.netlify.app (si falta se usa la variable URL de Netlify)
# Carpeta del correo LOCAL de desarrollo (por defecto .local/mail). Deshabilitado en producción.
MAIL_DIR=

# --- Panel del dueño (/admin) ---
# Correo de LA cuenta que puede administrar precios y stock. Sin este valor el panel queda cerrado para todos.
# Esa cuenta debe existir y tener el correo confirmado (se registra en /cuenta/registro). No hay contraseña por defecto.
ADMIN_EMAIL=

# --- Copias de seguridad (opcionales) ---
BACKUP_DIR=      # carpeta destino de npm run db:backup (por defecto ./backups)
BACKUP_KEEP=     # cuántas copias conservar (vacío = todas)

# --- Dólar y precios en pesos (tanda 6) ---
# Los precios base se cargan en USD desde /admin y se muestran en pesos con el dólar blue (venta). Ver docs/COTIZACION.md.
FX_AUTO_REFRESH=      # 0 = no salir a internet a buscar la cotización (pruebas / entornos sin red). Vacío = automática cada 15 min
FX_PROVIDER_URL=      # opcional: otro endpoint con el mismo formato que DolarAPI (por defecto https://dolarapi.com/v1/dolares/blue)
CRON_SECRET=          # opcional: habilita POST/GET /api/fx/refresh (Authorization: Bearer <valor>) para una tarea programada externa

# Carpeta de fotos SOLO para STORAGE_DRIVER=local (desarrollo/pruebas)
UPLOADS_DIR=

# --- Ingreso con Google (opcional) ---
# Sin ambas variables el botón «Continuar con Google» no aparece. Se crean en Google Cloud Console (ver docs/GOOGLE.md). SOLO servidor; jamás en el repositorio ni en el chat.
# URI de redireccionamiento autorizado: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Comprobantes de transferencia (almacenamiento PRIVADO) ---
# Bucket PRIVADO de Supabase Storage, distinto del de fotos de productos (que es público). Se crea con "Public bucket" DESACTIVADO. Ver docs/PEDIDOS.md.
# Usa SUPABASE_URL y SUPABASE_SECRET_KEY de arriba. Sin esto, subir comprobantes responde "no disponible" (nunca se cae al bucket público).
SUPABASE_RECEIPTS_BUCKET=payment-receipts
# Pruebas locales con STORAGE_DRIVER=local: carpeta de los comprobantes (por defecto .local/data/receipts, fuera de public/).
RECEIPTS_DIR=
