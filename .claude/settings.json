{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run dev *)",
      "Bash(npm run build)",
      "Bash(npm run start *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run catalog:check)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate)",
      "Bash(npm run db:seed)",
      "Bash(npm run verify)",
      "Bash(npm run release:check)",
      "Bash(npx playwright install chromium)",
      "Bash(git init)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git switch -c feature/tienda-pokemon)",
      "Bash(git switch feature/tienda-pokemon)",
      "Bash(git push origin HEAD)"
    ]
  }
}
